# Local development credentials for docker-compose.yml.
DATABASE_URL=postgresql://startodel:startodel@127.0.0.1:5432/startodel

# Set DATABASE_URL_TEST to a separate empty PostgreSQL database to run migration and isolation tests.
# DATABASE_URL_TEST=postgresql://startodel:startodel@127.0.0.1:5432/startodel_test

# Random secret of at least 32 characters for sealed Sessions and Email Challenge digests.
NUXT_APP_SECRET=

# Local GitHub OAuth App with callback http://localhost:3000/auth/github.
NUXT_OAUTH_GITHUB_CLIENT_ID=
NUXT_OAUTH_GITHUB_CLIENT_SECRET=

# Set to the public callback behind a TLS-terminating proxy.
# NUXT_OAUTH_GITHUB_REDIRECT_URL=https://startodel.example/auth/github

# Container startup applies pending migrations. Set false or 0 to skip.
RUN_MIGRATIONS=true

# Image defaults for the HTTP listener.
# HOST=0.0.0.0
# PORT=3000

# Serves the design showcase at /design outside development.
# NUXT_PUBLIC_DESIGN_SHOWCASE=true

# Production email sign-in requires SMTP_HOST. Development and tests capture mail.
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=

# Optional explicit capture for fixtures running a production build.
# MAIL_TRANSPORT=capture

# Dokploy trusts the first X-Forwarded-For address set by Traefik by default.
# Set this when exposing the app directly without a trusted proxy.
# TRUST_PROXY_IP=false
