# Local development credentials for docker-compose.yml.
DATABASE_URL=postgresql://startodel:startodel@127.0.0.1:5432/startodel

# Set DATABASE_URL_TEST to a separate empty PostgreSQL database to run migration tests.
# DATABASE_URL_TEST=postgresql://startodel:startodel@127.0.0.1:5432/startodel_test

# Reserved for session encryption.
NUXT_SESSION_PASSWORD=

# Reserved for the GitHub OAuth application.
NUXT_OAUTH_GITHUB_CLIENT_ID=
NUXT_OAUTH_GITHUB_CLIENT_SECRET=
